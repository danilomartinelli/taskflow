---
const features = [
  {
    icon: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stroke-accent"><path d="M12 2L2 7l10 5l10-5l-10-5zM2 17l10 5l10-5M2 12l10 5l10-5"></path></svg>`,
    title: "Gestão Flexível",
    description: "Adapte-se a qualquer metodologia com funcionalidades personalizáveis.",
  },
  {
    icon: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stroke-accent"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87m-4-1.13a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    title: "Colaboração em Tempo Real",
    description: "Mantenha sua equipe sincronizada com atualizações instantâneas.",
  },
  {
    icon: `<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stroke-accent"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>`,
    title: "Análises Detalhadas",
    description: "Tome decisões informadas com relatórios e métricas claras.",
  },
];
---
<section id="features" class="py-20 px-4 scroll-smooth">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-4xl font-bold text-white text-center mb-12">Recursos Poderosos</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="bg-gray-800 p-8 rounded-lg shadow-lg text-center">
          <div class="w-12 h-12 mx-auto mb-6" set:html={feature.icon}></div>
          <h3 class="text-xl font-semibold text-primary mb-3">{feature.title}</h3>
          <p class="text-muted">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
