---
import FeatureCard from "./FeatureCard.astro";
---

<section id="features" class="py-20 px-4 max-w-6xl mx-auto">
  <h2 class="text-4xl font-bold text-center mb-12">Recursos Essenciais</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <FeatureCard
      title="Gestão de Tarefas Intuitiva"
      description="Organize suas tarefas em quadros Kanban visuais, defina prioridades e acompanhe o progresso sem esforço."
    >
      <svg
        slot="icon"
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-layout-kanban"
      >
        <rect width="7" height="5" x="3" y="3" rx="1" />
        <rect width="7" height="9" x="14" y="3" rx="1" />
        <rect width="7" height="7" x="3" y="16" rx="1" />
        <rect width="7" height="5" x="14" y="14" rx="1" />
      </svg>
    </FeatureCard>

    <FeatureCard
      title="Prazos e Lembretes"
      description="Nunca perca um prazo importante com lembretes personalizáveis e visualização clara de todas as suas datas-limite."
    >
      <svg
        slot="icon"
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-calendar-clock"
      >
        <path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7.5" />
        <path d="M16 2v4" />
        <path d="M8 2v4" />
        <path d="M3 10h5" />
        <path d="M17.8 20.2 20 18h-2V14" />
        <path d="M12 22a8 8 0 0 0 6.34-12.96" />
      </svg>
    </FeatureCard>

    <FeatureCard
      title="Colaboração em Equipe"
      description="Compartilhe projetos com sua equipe, atribua tarefas e colabore em tempo real para alcançar seus objetivos juntos."
    >
      <svg
        slot="icon"
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-users"
      >
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </svg>
    </FeatureCard>
  </div>
</section>