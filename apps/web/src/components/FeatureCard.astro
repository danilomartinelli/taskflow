---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div
  class="bg-surface border border-border p-6 rounded-xl flex flex-col items-center text-center"
>
  <div class="text-neon mb-4">
    <slot name="icon" />
  </div>
  <h3 class="text-2xl font-bold mb-2">{title}</h3>
  <p class="text-muted">
    {description}
  </p>
</div>