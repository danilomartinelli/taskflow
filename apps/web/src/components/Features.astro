      <!-- Feature 1 -->
      <div class="bg-surface p-8 rounded-lg shadow-lg flex flex-col items-center text-center">
        <svg class="w-16 h-16 text-accent mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M17 17h.01"></path>
        </svg>
        <h3 class="text-2xl font-semibold mb-4">Organização Inteligente</h3>
        <p class="text-muted-foreground">Categorize suas tarefas, defina prioridades e adicione tags para nunca perder o controle.</p>
      </div>
      <!-- Feature 2 -->
      <div class="bg-surface p-8 rounded-lg shadow-lg flex flex-col items-center text-center">
        <svg class="w-16 h-16 text-accent mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
